# Local manager runtime configuration. Replace placeholders in your untracked .env.manager.
DATABASE_URL=postgresql://manager:manager@localhost:5433/manager
REDIS_URL=redis://localhost:6380/0
SESSION_SECRET=replace-with-a-random-secret-at-least-16-characters
WORKER_CONCURRENCY=3
BROWSER_CONCURRENCY=2
EXTERNAL_POLL_INTERVAL_SECONDS=15
EXTERNAL_POLL_TIMEOUT_SECONDS=900
HEALTHCHECK_TIMEOUT_SECONDS=3
