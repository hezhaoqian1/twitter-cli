FROM python:3.12-slim

WORKDIR /app

COPY pyproject.toml uv.lock README.md ./
COPY twitter_cli ./twitter_cli
COPY manager_api ./manager_api
COPY alembic.ini ./
COPY alembic ./alembic
COPY scripts ./scripts

RUN pip install --no-cache-dir uv \
    && uv sync --no-dev --frozen

EXPOSE 8000

CMD ["sh", "-c", "python scripts/manager_migrate.py && exec uvicorn --factory manager_api.main:create_app --host 0.0.0.0 --port ${PORT:-8000}"]
